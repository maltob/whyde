{
  "name": "@ide/storage-browser",
  "version": "0.1.0",
  "description": "IndexedDB-backed project repository, revision management, and autosave",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./autosave": {
      "types": "./dist/autosave.d.ts",
      "import": "./dist/autosave.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@ide/project-model": "workspace:*",
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
